# Normalize line endings for everything we author.
* text=auto eol=lf

# A copy of the public OpenAPI document of the Flashpi API (`composer openapi:sync`).
openapi/openapi.json linguist-generated
# Generated from that copy (`composer openapi:generate`).
src/Types/ApiTypes.php linguist-generated
# The README examples, extracted from the READMEs (`composer readme:generate`).
tests/Examples/Readme/en_*.php linguist-generated
tests/Examples/Readme/es_*.php linguist-generated

# Composer installs the package from GitHub's archive of a tag: keep everything that is not the
# library out of it.
/.github export-ignore
/docs export-ignore
/openapi export-ignore
/scripts export-ignore
/tests export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.php-cs-fixer.dist.php export-ignore
/.release-please-manifest.json export-ignore
/CONTRIBUTING.md export-ignore
/SECURITY.md export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
/release-please-config.json export-ignore
