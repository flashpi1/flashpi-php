# PHPStan at the highest level over the library and its tests.
#
# Besides `level: max`:
# - bleedingEdge makes array shapes sealed: an array with a key the shape does not declare (a typo
#   in a request body) is an error, as a TypedDict or a TypeScript object literal would be. The
#   consumer files in tests/Types/ rely on it.
# - treatPhpDocTypesAsCertain is off: the SDK checks at run time what callers pass (options,
#   headers, webhook payloads) even where its PHPDoc already narrows the type, since PHP does not
#   enforce PHPDoc types.
# - The other flags turn on checks that `max` leaves off: uninitialized properties, benevolent
#   unions (`array-key`), callables without a signature, possibly missing array offsets, @var tags
#   that lie or widen a type, and conditions that are always true.
includes:
  - vendor/phpstan/phpstan/conf/bleedingEdge.neon

parameters:
  level: max
  paths:
    - src
    - tests
  tmpDir: .phpstan.cache
  treatPhpDocTypesAsCertain: false
  checkUninitializedProperties: true
  checkBenevolentUnionTypes: true
  checkMissingCallableSignature: true
  checkTooWideReturnTypesInProtectedAndPublicMethods: true
  checkDynamicProperties: true
  reportAlwaysTrueInLastCondition: true
  reportAnyTypeWideningInVarTag: true
  reportPossiblyNonexistentConstantArrayOffset: true
  reportPossiblyNonexistentGeneralArrayOffset: true
  reportWrongPhpDocTypeInVarTag: true
