<?xml version="1.0" encoding="UTF-8"?>
<!--
  Strict on purpose: a warning, a notice, a deprecation, a risky test or output during a test fails
  the run, and every exception keeps the arguments of its frames, so the tests see what an error
  tracker would (the SDK's secrets must not be among them).
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="vendor/autoload.php"
    cacheDirectory=".phpunit.cache"
    colors="true"
    executionOrder="depends,defects"
    beStrictAboutChangesToGlobalState="true"
    beStrictAboutOutputDuringTests="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
    displayDetailsOnIncompleteTests="true"
    displayDetailsOnSkippedTests="true"
    displayDetailsOnTestsThatTriggerDeprecations="true"
    displayDetailsOnTestsThatTriggerErrors="true"
    displayDetailsOnTestsThatTriggerNotices="true"
    displayDetailsOnTestsThatTriggerWarnings="true"
    displayDetailsOnPhpunitDeprecations="true"
    failOnDeprecation="true"
    failOnEmptyTestSuite="true"
    failOnIncomplete="true"
    failOnNotice="true"
    failOnPhpunitDeprecation="true"
    failOnRisky="true"
    failOnWarning="true">
  <testsuites>
    <testsuite name="unit">
      <directory>tests</directory>
    </testsuite>
  </testsuites>

  <!-- tests/Live runs against the real API only when asked for: composer test:live. -->
  <groups>
    <exclude>
      <group>live</group>
    </exclude>
  </groups>

  <!--
    Coverage counts the library and the scripts' classes. The command-line entry points only read
    their arguments and call those classes; CI runs them as steps of their own.
  -->
  <source ignoreIndirectDeprecations="true">
    <include>
      <directory>src</directory>
      <directory>scripts</directory>
    </include>
    <exclude>
      <file>scripts/installed_check.php</file>
      <file>scripts/openapi.php</file>
      <file>scripts/package_check.php</file>
      <file>scripts/readme.php</file>
    </exclude>
  </source>

  <php>
    <ini name="error_reporting" value="-1"/>
    <ini name="display_errors" value="1"/>
    <ini name="zend.exception_ignore_args" value="0"/>
    <ini name="memory_limit" value="512M"/>
  </php>
</phpunit>
